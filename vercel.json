{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/publish-market", "schedule": "*/30 * * * *" }
  ],
  "rewrites": [
    { "source": "/marketplace", "destination": "/index.html" },
    { "source": "/marketplace/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/", "destination": "/index.html" }
  ]
}
